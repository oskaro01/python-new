@page { size: A4; margin: 18mm; }
* { box-sizing: border-box; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
body { margin: 0; font-family: Arial, sans-serif; color: #252a2c; font-size: 12pt; line-height: 1.6; }
h1 { font-size: 28pt; line-height: 1.2; margin: 12px 0 18px; }
h2 { font-size: 16pt; margin-top: 28px; }
.eyebrow { color: #26715a; font-size: 10pt; font-weight: bold; }
.intro { color: #596162; font-size: 15pt; }
table { width: 100%; border-collapse: collapse; margin: 22px 0; }
th, td { padding: 10px; border: 1px solid #cdd6d2; text-align: left; }
th { background: #e5f1eb; }
tr, img { break-inside: avoid; }
.next-page { break-before: page; }
.ending { border-top: 2px solid #26715a; padding-top: 16px; margin-top: 28px; }
@media print { .screen-only { display: none; } }

