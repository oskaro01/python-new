# Copy this file to .env and replace the placeholders.
# Never commit the real .env file.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me_from_stripe_listen

# Use PAYMENT_PROVIDER=bkash only after bKash sandbox onboarding.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CURRENCY=BDT
BKASH_TIMEOUT=30

RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEFAULT_FROM_EMAIL=receipts@mini-checkout.local

DATABASE_URL=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

FULFILLMENT_PROVIDER=manual
