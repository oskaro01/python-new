# Copy the DSN from your Sentry project's Django setup page.
# Leave empty to disable reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Local defaults. Render should provide these as environment variables.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-for-a-real-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
PRIVATE_MEDIA_ROOT=private_media

# Temporary Chat Lab images expire after this many days.
CHAT_ATTACHMENT_TTL_DAYS=7

# Messages live for 24 hours. Use 60 for newly sent local test messages.
CHAT_MESSAGE_TTL_SECONDS=86400
