# Copy the DSN from your Sentry project's Django setup page.
# Leave empty to disable reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Local defaults. Render should provide these as environment variables.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-for-a-real-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
PRIVATE_MEDIA_ROOT=private_media

# Chat text and attachments expire after five minutes. Use 60 for faster tests.
CHAT_ATTACHMENT_TTL_SECONDS=300
CHAT_MESSAGE_TTL_SECONDS=300

# Leave empty for the local in-memory channel layer. Render should provide a
# Redis/Key Value connection URL for multi-process WebSocket broadcasting.
REDIS_URL=
